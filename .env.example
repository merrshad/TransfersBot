# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Bot tokens issued by @BotFather (Telegram) and Bale's bot platform.
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
BALE_BOT_TOKEN=replace-with-bale-bot-token

# Base URL of the Bale Bot API (compatible with the Telegram Bot API).
BALE_API_BASE_URL=https://tapi.bale.ai

# Numeric ids of the bridge owner on each platform.
TELEGRAM_OWNER_ID=123456789
BALE_OWNER_ID=123456789

# Maximum number of registered users. 0 means unlimited.
MAX_USERS=0

# Maximum simultaneously active pairs per user.
MAX_PAIRS_PER_USER=1

# Lifetime of a pending pairing request, in hours.
PAIR_REQUEST_TTL_HOURS=24

# SQLite database file. The parent directory is created automatically.
DB_PATH=data/bridge.db

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Long-polling timeout for getUpdates, in seconds (1..300).
POLL_TIMEOUT_SECONDS=25

# ---------------------------------------------------------------------------
# Delivery reliability (phase 4). The outbox is a durable queue: an entry is
# leased, retried with exponential backoff and only marked failed after
# OUTBOX_MAX_ATTEMPTS. Nothing is lost on a crash/restart.
# ---------------------------------------------------------------------------

# How often the delivery worker polls the queue, in seconds.
OUTBOX_POLL_INTERVAL_SECONDS=2

# Total failed attempts before an entry becomes terminally failed.
OUTBOX_MAX_ATTEMPTS=5

# Backoff: first delay, multiplier cap, jitter fraction (0..1).
OUTBOX_RETRY_BASE_SECONDS=10
OUTBOX_RETRY_MAX_SECONDS=300
OUTBOX_RETRY_JITTER=0.2

# A sending lease older than this is recovered even without a restart.
OUTBOX_STALE_SENDING_SECONDS=300

# A media upload timeout is ambiguous: Telegram/Bale may have accepted the
# file before the client timed out. Retrying would duplicate it, so by default
# such an entry becomes failed instead of being retried.
OUTBOX_MEDIA_TIMEOUT_TERMINAL=true

# After a successful delivery the payload (text/caption/file handle) is
# scrubbed immediately. The content-free tombstone row is deleted after this
# many days. 0 disables the age-based purge.
OUTBOX_SENT_RETENTION_DAYS=7

# How long a clean shutdown waits for the in-flight pass before cancelling.
SHUTDOWN_TIMEOUT_SECONDS=30

# Telegram HTTP timeouts. Uploads need much more than PTB's defaults.
TELEGRAM_CONNECT_TIMEOUT_SECONDS=30
TELEGRAM_READ_TIMEOUT_SECONDS=300
TELEGRAM_WRITE_TIMEOUT_SECONDS=600

# ---------------------------------------------------------------------------
# Send-rate limits. 0 disables a limit.
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true

# Global sends per second, per platform.
TELEGRAM_GLOBAL_MESSAGES_PER_SECOND=25
BALE_GLOBAL_MESSAGES_PER_SECOND=20

# Sends per second to a single chat, per platform.
TELEGRAM_CHAT_MESSAGES_PER_SECOND=1
BALE_CHAT_MESSAGES_PER_SECOND=1

# Anti-spam: relayed messages allowed per source user per minute.
USER_MESSAGES_PER_MINUTE=30

# queue = keep the message and send guidance; reject = fail the excess message.
USER_RATE_LIMIT_ACTION=queue

# Send at most one rate-limit guidance note per user per this many seconds.
USER_RATE_LIMIT_NOTICE_COOLDOWN_SECONDS=60

# ---------------------------------------------------------------------------
# Optional Docker health check: the worker rewrites this file after each pass.
# Example HEALTHCHECK: test -f /app/data/health && test $(( $(date +%s) -
# $(stat -c %Y /app/data/health) )) -lt 90
# Leave empty to disable.
# ---------------------------------------------------------------------------
HEALTHCHECK_FILE=data/health
HEALTHCHECK_MAX_AGE_SECONDS=90

# ---------------------------------------------------------------------------
# Media relaying. The byte limits below are the documented platform ceilings
# (Telegram Bot API / https://docs.bale.ai): 20 MB per getFile download, 10 MB
# per photo upload and 50 MB for every other file. Tighten them to keep the
# bridge inside a smaller budget; raising them above the platform cap only
# moves the failure to the API.
# ---------------------------------------------------------------------------

# Enable attachment relaying. When false, media messages are not relayed.
MEDIA_ENABLED=true

# Directory for files spooled between download and upload.
MEDIA_TEMP_DIR=data/tmp

# Per-user ceiling for spooled bytes (a relay is rejected beyond it).
MEDIA_USER_QUOTA_MB=200

# How long to collect the members of one album before relaying them (seconds).
MEDIA_GROUP_WINDOW_SECONDS=0.8

# Telegram: getFile download cap, media upload cap, photo upload cap (MB).
TELEGRAM_MAX_DOWNLOAD_MB=20
TELEGRAM_MAX_UPLOAD_MB=50
TELEGRAM_MAX_PHOTO_UPLOAD_MB=10

# Bale: getFile download cap, media upload cap, photo upload cap (MB).
BALE_MAX_DOWNLOAD_MB=20
BALE_MAX_UPLOAD_MB=50
BALE_MAX_PHOTO_UPLOAD_MB=10
